{
  "name": "@openclaw/ai",
  "version": "2026.7.2",
  "description": "Reusable model provider adapters and streaming runtime from OpenClaw",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "default": "./dist/providers.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./event-stream": {
      "types": "./dist/event-stream.d.ts",
      "import": "./dist/event-stream.js",
      "default": "./dist/event-stream.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./internal/*": {
      "types": "./dist/internal/*.d.ts",
      "import": "./dist/internal/*.js",
      "default": "./dist/internal/*.js"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.109.1",
    "@google/genai": "2.10.0",
    "@mistralai/mistralai": "2.4.0",
    "openai": "6.45.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.3"
  }
}
